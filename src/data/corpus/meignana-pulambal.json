{"id":"meignana-pulambal","siddhar":"bhadragiriyar","titleTa":"மெய்ஞ்ஞானப் புலம்பல்","titleEn":"Meignana Pulambal","source":["pm0074"],"verses":[{"n":1,"label":"1","lines":["முக்திதரும் ஞான மொழியாம் புலம்பல் சொல்ல","அத்தி முகவன்தன் அருள் பெருவது எக்காலம்?","நூல்","ஆங்காரம் உள்ளடக்கிய ஐம்புலனைச் சுட்டறுத்துத்","தூங்காமல் தூங்கிச் சுகம் பெறுவது எக்காலம்?"]},{"n":2,"label":"2","lines":["நீங்காச் சிவயோக நித்திரை கொண்டே இருந்து","தேங்காக் கருணை வெள்ளம் தேக்குவதும் எக்காலம்?"]},{"n":3,"label":"3","lines":["தேங்காக் கருணைவெள்ளம் தேக்கியிருந்து உண்பதற்கு","வாங்காமல் விட்டகுறை வந்தெடுப்பது எக்காலம்?"]},{"n":4,"label":"4","lines":["ஓயாக் கவலையினால் உள்ளுடைந்து வாடாமல்","மாயாப் பிறவி மயக்கு அறுப்பது எக்காலம்?"]},{"n":5,"label":"5","lines":["மாயாப் பிறவி மயக்கத்தை ஊடறுத்துக்","காயா புரிக்கோட்டை கைக் கொள்வது எக்காலம்?"]},{"n":6,"label":"6","lines":["காயா புரிக்கோட்டை கைவசமாய்க் கொள்வதற்கு","மாயா அனுபூதி வந்துஅடுப்பது எக்காலம்?"]},{"n":7,"label":"7","lines":["சேயாய்ச் சமைந்து, செவிடு ஊமை போல் திரிந்து","பேய்போல் இருந்து உன் பிரமை கொள்வது எக்காலம்?"]},{"n":8,"label":"8","lines":["பேய் போல்திரிந்து பிணம்போல் கிடந்து பெண்ணைத்","தாய்போல் நினைத்து தவம் முடிப்பது எக்காலம்?"]},{"n":9,"label":"9","lines":["கால்காட்டிக் கைகாட்டிக் கண்கள் முகம்காட்டி","மால்காட்டும் மங்கையரை மறந்து இருப்பது எக்காலம்?"]},{"n":10,"label":"10","lines":["பெண்ணினல்லார் ஆசைப் பிரமையினை விட்டொழிந்து","கண்ணிரண்டும் மூடிக் கலந்திருப்பது எக்காலம்?"]},{"n":11,"label":"1","lines":["வெட்டுண்ட புண்போல் விரிந்த அல்குல் பைதனிலே","தட்டுண்டு நிற்கை தவிர்வதுவும் எக்காலம்? 1"]},{"n":12,"label":"12","lines":["ஆறாத புண்ணில் அழுந்திக் கிடவாமல்","தேறாத சிந்தைதனைத் தேற்றுவதும் எக்காலம்?"]},{"n":13,"label":"13","lines":["தந்தை, தாய், மக்கள், சகோதரரும் பொய்யெனவே","சிந்தைதனில் கண்டு திருக்கறுப்பது எக்காலம்?"]},{"n":14,"label":"14","lines":["மன்னுயிரைக் கொன்று வதைத்து உண்டு உழலாமல்;","தன்னுயிர்போல் எண்ணித் தவம் முடிப்பது எக்காலம்?"]},{"n":15,"label":"15","lines":["பாவி என்ற பேர்படைத்துப் பாழ்நரகில் வீழாமல்;","ஆவி என்ற சூத்திரத்தை அறிவது இனி எக்காலம்?"]},{"n":16,"label":"16","lines":["உளியிட்ட கல்லும், உருப்பிடித்த செஞ்சாந்தும்","புளியிட்ட செம்பும் பொருளாவது எக்காலம்?"]},{"n":17,"label":"17","lines":["வேடிக்கையும் சொகுசும் மெய்ப்பகட்டும் பொய்ப்பகட்டும்","வாடிக்கை எல்லாம் மறந்திருப்பது எக்காலம்?"]},{"n":18,"label":"18","lines":["பட்டுடை பொற்பணியும் பாவனையும் தீவினையும்","விட்டுவிட்டு உன்பாதம் விரும்புவதும் எக்காலம்?"]},{"n":19,"label":"19","lines":["ஆமைவரும் ஆள்கண்டு ஐந்தடக்கம் செய்தாற்போல்","ஊமை உருக்கொண்டு ஒடுங்குவதும் எக்காலம்?"]},{"n":20,"label":"20","lines":["தண்டிகையும், சாவடியும், சாளிகையும், மாளிகையும்","கண்டு களிக்கும் கருத்தொழிவது எக்காலம்?"]},{"n":21,"label":"21","lines":["அத்தன் இருப்பிடத்தை ஆராய்ந்து பார்த்து நிதம்","செத்த சவம்போல் திரிவதினி எக்காலம்?"]},{"n":22,"label":"22","lines":["ஒழிந்த தருமத்தினை வைத்துள்ளெலும்பு வெள்ளெலும்பாய்க்","கழிந்த பிணம்போல்இ ழிந்து காண்பதினி எக்காலம்?"]},{"n":23,"label":"23","lines":["அற்பசுகம் மறந்தே அறிவை அறிவால் அறிந்து","கெர்ப்பத்தில் வீழிந்து கொண்ட கோளறுப்பது எக்காலம்?"]},{"n":24,"label":"24","lines":["கருப்படுத்தி என்னை யமன் கைப்பிடித்துக் கொள்ளாமுன்","உருப்படுத்தி ஆள உடன்படுவது எக்காலம்?"]},{"n":25,"label":"25","lines":["தூண்டு விளக்கணைய தொடர்ந்து இருள் முன் சூழ்ந்தாற்போல்","மாண்டு பிழைத்துவந்த வகை தெரிவது எக்காலம்?"]},{"n":26,"label":"26","lines":["தூரியினில் மீன்போல் சுழன்று மனம் வாடாமல்","ஆரியனைத் தேடி அடிபணிவது எக்காலம்?"]},{"n":27,"label":"27","lines":["எண்ணூறு யுகமிருந்தும் எய்தாத விடுபெற","வெண்ணீறு பூசி விளங்குவதும் எக்காலம்?"]},{"n":28,"label":"28","lines":["அவவேடம் பூண்டு இங்கு அலைந்து திரியாமல்","சிவவேடம் பூண்டு சிறந்திருப்பது எக்காலம்?"]},{"n":29,"label":"29","lines":["அண்டருக்காய் நஞ்சருந்தி அம்பலத்தில் ஆடுசிவன்","தொண்டருக்குத் தொண்டன் எனத் தொண்டு செய்வது எக்காலம்?"]},{"n":30,"label":"30","lines":["பன்றி வடிவெடுத்துப் பார் இடந்து மால்காணாக்","குன்றில் விளக்கொளியைக் கூறுவதும் எக்காலம்?"]},{"n":31,"label":"31","lines":["தித்திக்கும் தெள்ளமிழ்தை சித்தாந்தத்து உட்பொருளை","முத்திக்கு வித்தை முதல் நினைப்பது எக்காலம்?"]},{"n":32,"label":"32","lines":["வேதாந்தவேதம் எல்லாம் விட்டொழிந்தே நிட்டையிலே","ஏகாந்தமாக இருப்பதினி எக்காலம்?"]},{"n":33,"label":"33","lines":["மற்றிடத்தைத் தேடி என்றன் வாழ்நாளைப் போக்காமல்","உற்றிடத்தைத் தேடி உறங்குவதும் எக்காலம்?"]},{"n":34,"label":"34","lines":["இன்றுளோர் நாளை இருப்பதுவும் பொய்யெனவே","மன்றுளோர் சொல்லும் வகையறிவது எக்காலம்?"]},{"n":35,"label":"35","lines":["கஞ்சா அபினியுடன் கள்ளுண்டு வாடாமல்","பஞ்சா மிர்தம் பருகுவதும் எக்காலம்?"]},{"n":36,"label":"36","lines":["செஞ்சலத்தினால் திரண்ட சென்ன மோட்சம்பெறவே","சஞ்சலத்தை விட்டு உன் சரண் அடைவது எக்காலம்?"]},{"n":37,"label":"37","lines":["கும்பிக்கு இரைதேடிக் கொடுப்பார் இடம்தோறும்","வெம்பித் திரிகை விடுப்பது இனி எக்காலம்?"]},{"n":38,"label":"38","lines":["ஆடுகின்ற சூத்திரம் தான் அறுமளவுமேதிரிந்து","போடுகின்ற நாள் வருமுன் போற்றுவதும் எக்காலம்?"]},{"n":39,"label":"39","lines":["நவசூத் திர வீட்டை நான்என்று அலையாமல்","சிவசூத் திரத்தைத் தெரிந்தறிவது எக்காலம்?"]},{"n":40,"label":"40","lines":["பரந்து மலசலங்கள் பாயும் புழுக்கூட்டை விட்டுக்","கரந்துன் அடிஇணைக்கீழ்க் கலந்து நிற்பது எக்காலம்?"]},{"n":41,"label":"41","lines":["இம்மைதனில் பாதகனாய் இருவினைக்கீடாய் எடுத்த","பொம்மைதனைப்போட்டு உன்னைப் போற்றி நிற்பது எக்காலம்?"]},{"n":42,"label":"42","lines":["உப்பிட்ட பாண்டம் உடைந்து கருக்கொள்ளு முன்னே","அப்பிட்ட வேணியனுக்கு ஆட்படுவது எக்காலம்?"]},{"n":43,"label":"43","lines":["சேவைபுரிந்து சிவரூபக் காட்சிகண்டு","பாவைதனைக் கழித்துப் பயன் அடைவது எக்காலம்?"]},{"n":44,"label":"44","lines":["காண்டத்தை வாங்கிக் கருமேகம் மீண்டது போல்","பாண்டத்தை நீக்கிப் பரம் அடைவது எக்காலம்?"]},{"n":45,"label":"45","lines":["சோற்றுத் துருத்திதனைச் சுமந்து அலைந்து வாடாமல்","ஊத்தைச் சடம்போட்டு உனை அடைவது எக்காலம்?"]},{"n":46,"label":"46","lines":["தொடக்கைச் சதம் எனவே சுமந்து அலைந்து வாடாமல்","உடக்கைக் கழற்றி உனைஅறிவது எக்காலம்?"]},{"n":47,"label":"47","lines":["ஆசைவலைப் பாசத்து அகப்பட்டு மாயாமல்","ஓசைமணித் தீபத்தில் ஒன்றி நிற்பது எக்காலம்?"]},{"n":48,"label":"48","lines":["கூறரிய நால் வேதம் கூப்பிட்டும் காணாத","பார ரகசியத்தைப் பார்த்திருப்பது எக்காலம்?"]},{"n":49,"label":"49","lines":["புல்லாய் விலங்காய் புழுவாய் நரவடிவாய்","எல்லாப் பிறப்பின் இருள் அகல்வது எக்காலம்?"]},{"n":50,"label":"50","lines":["தக்கும்வகைக்கு ஓர்பொருளும் சாராம லேநினைவில்","பக்குவம்வந்துன் அருளைப் பார்த்திருப்பது எக்காலம்?"]},{"n":51,"label":"51","lines":["பருவத் தலைவரொடும் புல்கியின்பம் கொள்வதற்குத்","தெரிவைப் பருவம் வந்து சிக்குவதும் எக்காலம்?"]},{"n":52,"label":"52","lines":["தெரிவையுறும் பக்குவத்தின் சீராட்டெல்லாம் அறிந்து","குருவை அறிந்தேநினைத்துக் கும்பிடுவது எக்காலம்?"]},{"n":53,"label":"53","lines":["வம்படிக்கும் மாதருடன் வாழ்ந்தாலும் மன்னுபுளி","யம்பழமும் ஓடும்போல் ஆவதினி எக்காலம்?"]},{"n":54,"label":"54","lines":["பற்றற்று நீரில் படர்தா மரை இலைபோல்","சுற்றத்தை நீக்கிமனம் தூர நிற்பது எக்காலம்?"]},{"n":55,"label":"55","lines":["சல்லாப லீலையிலே தன்மனைவி செய்தசுகம்","சொல்லாரக் கண்டு எனக்குச் சொல்வதினி எக்காலம்?"]},{"n":56,"label":"56","lines":["மருவும் அயல்புருடன் வரும் நேரம் காணாமல்","உருகுமனம் போல் என் உளம் உருகுவதும் எக்காலம்?"]},{"n":57,"label":"57","lines":["தன்கணவன் தன் சுகத்தில் தன்மனம்வே றானது போல்","என் கருத்தில் உன் பதத்தை ஏற்றுவதும் எக்காலம்?"]},{"n":58,"label":"58","lines":["கூடிப் பிரிந்துவிட்ட கொம்பனையைக் காணாமல்","தேடித் தவிப்பவன் போல் சிந்தை வைப்பது எக்காலம்?"]},{"n":59,"label":"59","lines":["எவ்வனத்தின் மோகம் எப்படி யுண்டப்படிபோல்","கவ்வனத் தியானம் கருத்து வைப்பது எக்காலம்?"]},{"n":60,"label":"60","lines":["கண்ணால் அருவி கசிந்து முத்துப் போல் உதிரச்","சொன்ன பரம்பொருளை எண்ணுவது எக்காலம்?"]},{"n":61,"label":"61","lines":["ஆகம் மிகவுருக அன்புருக என்புருகப்","போகஅனுபூதி பொருந்துவதும் எக்காலம்?"]},{"n":62,"label":"62","lines":["நீரில் குமிழிபோல் நிலையற்ற வாழ்வை விட்டுநின்","பேரின்பக் கருணை வெள்ளம் பெருக்கெடுப்பது எக்காலம்?"]},{"n":63,"label":"63","lines":["அன்பை உருக்கி அறிவை அதன் மேல்புகட்டித்","துன்ப வலைப்பாசத் தொடக்கறுப்பது எக்காலம்?"]},{"n":64,"label":"64","lines":["கருவின் வழி அறிந்து கருத்தைச் செலுத்தாமல்","அருவி விழிசொரிய அன்பு வைப்பது எக்காலம்?"]},{"n":65,"label":"65","lines":["தெள்ளத் தெளிய தெளிந்த சிவானந்ததேன்","பொழியப் பொழிய மனம் பூண்டிருப்பது எக்காலம்?"]},{"n":66,"label":"66","lines":["ஆதார மூலத்தடியில் கணபதியைப்","பாதார விந்தம் பணிந்து நிற்பது எக்காலம்?"]},{"n":67,"label":"67","lines":["மண்வளைந்த நற்கீற்றில் வளைந்திருந்த வேதாவைக்","கண்வளர்த்துப் பார்த்துள்ளே கண்டிருப்பது எக்காலம்?"]},{"n":68,"label":"68","lines":["அப்புப் பிறை நடுவே அமர்ந்திருந்த விட்டுணுவை","உப்புக் குடுக்கையுள்ளே உணர்ந்தறிவது எக்காலம்?"]},{"n":69,"label":"69","lines":["மூன்று வளையம் இட்டு முளைத்தெழுந்த கோணத்தில்","தோன்றும் உருத்திரனைத் தொழுது நிற்பது எக்காலம்?"]},{"n":70,"label":"70","lines":["வாயு அறுகோணத்தில் வாழும் மகேச்சுரனைத்","தோயும் வகை கேட்கத் தொடங்குவதும் எக்காலம்?"]},{"n":71,"label":"71","lines":["வட்டவழிக்குள்ளே மருவும் சதாசிவத்தைக்","கிட்ட வழிதேடக் கிருபை செய்வது எக்காலம்?"]},{"n":72,"label":"72","lines":["உச்சிக் கிடை நடுவே ஓங்கும் குருபதத்தை","நிச்சயித்துக் கொண்டிருந்து நேர்வதினி எக்காலம்?"]},{"n":73,"label":"73","lines":["பாராகிப் பார்மீதில் பஞ்சவன்னம் தானாகி","வேராகி நீமுளைத்த வித்தறிவது எக்காலம்?"]},{"n":74,"label":"74","lines":["கட்டறுக்க வொண்ணாக் கருவிகர ணாதி எல்லாம்","சுட்டறுத்து நிட்டையிலே தூங்குவதும் எக்காலம்?"]},{"n":75,"label":"75","lines":["கள்ளக் கருத்தை எல்லாம் கட்டோடு வேரறுத்து இங்கு","உள்ளக் கருத்தை உணர்ந்திருப்பது எக்காலம்?"]},{"n":76,"label":"76","lines":["அட்டகாசம் செலுத்தும் அவத்தைச் சடலத்துடனே","பட்டபாடு அத்தனையும் பகுத்தறிவது எக்காலம்?"]},{"n":77,"label":"77","lines":["அறிவுக் கருவியுடன் அவத்தைபடும் பாட்டை எல்லாம்","பிறிவுபட இருத்திப் பெலப்படுவது எக்காலம்?"]},{"n":78,"label":"78","lines":["பூதம் பொறிகரணம் போந்தவிந்து நாதமாய்ப்","பேதம் பலவிதமும் பிரித்தறிவது எக்காலம்?"]},{"n":79,"label":"79","lines":["தோன்றாசை மூன்றும் பிரிந்தறிவது எக்காலம்?","ஊன்றாசை வேரை அடிஊடறுப்பது எக்காலம்?"]},{"n":80,"label":"80","lines":["புன்சனனம் போற்று முன்னே புரிவட்டம் போகில் இனி","என் சனனம் ஈடேறும் என்றறிவது எக்காலம்?"]},{"n":81,"label":"81","lines":["நட்ட நடுவில்நின்று நல்திரோதாயி அருள்","கிட்டவழி காட்டிக் கிருபை செய்வது எக்காலம்?"]},{"n":82,"label":"82","lines":["நானே நான் என்றிருந்தேன் நடுவினின்ற கட்டழகி","நானே வெளிப்படுத்தித் தருவன் என்பதும் எக்காலம்?"]},{"n":83,"label":"83","lines":["அடர்ந்த மனக்காட்டை அஞ்செழுத்தாம் வாளாலே","தொடர்ந்து தொடர்ந்து வெட்டிச் சுடுவது இனிஎக்காலம்?"]},{"n":84,"label":"84","lines":["ஐந்து பொறிவழிபோய் அலையும் இந்தப் பாழ்மனத்தை","வெந்து விழப் பார்த்து விழிப்பது இனி எக்காலம்?"]},{"n":85,"label":"85","lines":["இனமாண்டு சேர்திருந்தோர் எல்லோரும் தாமாண்டு","சினமாண்டு போக அருள் தேர்ந்திருப்பது எக்காலம் ?"]},{"n":86,"label":"86","lines":["அமையாமனம் அமையும் ஆனந்த வீடுகண்டு அங்கு","இமையாமல் நோக்கி இருப்பது எக்காலம்?"]},{"n":87,"label":"87","lines":["கூண்டுவிழும் சீவன் மெள்ளக் கொட்டாவி கொண்டாற்போல்","மாண்டுவிழும் முன்னே நான் மாண்டிருப்பது எக்காலம்?"]},{"n":88,"label":"88","lines":["ஊன் நிறைந்த காயம் உயிர் இழந்து போகுமுன்னம்","நான் இறந்து போக இனி நாள் வருவது எக்காலம்?"]},{"n":89,"label":"89","lines":["கெட்டுவிடும் மாந்தர் கெர்விதங்கள் பேசி வந்து","சுட்டுவிடுமுன் என்னைச் சுட்டிருப்பது எக்காலம்?"]},{"n":90,"label":"90","lines":["தோல் ஏணி வைத்தேறித் தூரநடந் தெய்க்காமல்","நூல் ஏணி வைத்தேறி நோக்குவதும் எக்காலம்?"]},{"n":91,"label":"91","lines":["வாயோடு கண்மூடி மயக்கமுற்று நில்லாமல்","தாயோடு கண்மூடி தழுவி நிற்பது எக்காலம்?"]},{"n":92,"label":"92","lines":["காசினியெலாம் நடந்து கால் ஓய்ந்து போகாமல்","வாசிதனில் ஏறிவருவது இனி எக்காலம்?"]},{"n":93,"label":"93","section":"ஒலிபடரும் கு","lines":["ண்டலியை உன்னி உணர்வால் எழுப்பிச்","சுழுமுனையின் தாள்திறந்து தூண்டுவதும் எக்காலம்?"]},{"n":94,"label":"94","section":"ஒலிபடரும் கு","lines":["இடைபிங் கலைநடுவே இயங்கும் சுழுமுனையில்","தடை அறவே நின்று சலித்தருப்பது எக்காலம்?"]},{"n":95,"label":"95","section":"ஒலிபடரும் கு","lines":["மூலநெருப்பைவிட்டு மூட்டு நிலா மண்டபத்தில்","பாலை இறக்கி உண்டு பசி ஒழிவது எக்காலம்?"]},{"n":96,"label":"96","section":"ஒலிபடரும் கு","lines":["ஆக வெளிக்குள்ளே அடங்காப் புரவி செல்ல","ஏக வெளியில் இருப்பது இனி எக்காலம்?"]},{"n":97,"label":"97","section":"ஒலிபடரும் கு","lines":["பஞ்சரித்துப் பேசும்பல்கலைக்கு எட்டாப் பொருளில்","சஞ்சரித்து வாழ்ந்து தவம் பெறுவது எக்காலம்?"]},{"n":98,"label":"98","section":"ஒலிபடரும் கு","lines":["மலமும் சலமும்அற்று மாயை அற்று மானம் அற்று","நலமும் குலமும் அற்று நான் இருப்பது எக்காலம்?"]},{"n":99,"label":"99","section":"ஒலிபடரும் கு","lines":["ஓடாமல் ஓடி உலகை வலம் வந்து சுற்றித்","தேடாமல் என்னிடமாய்த் தெரிசிப்பது எக்காலம்?"]},{"n":100,"label":"100","section":"ஒலிபடரும் கு","lines":["அஞ்ஞானம் விட்டே, அருள் ஞானத்து எல்லைதொட்டு","மெய்ஞ்ஞான வீடுபெற்று வெளிப்படுவது எக்காலம்?"]},{"n":101,"label":"1","section":"ஒலிபடரும் கு","lines":["வெல்லும்மட்டும் பார்த்து, வெகுளியெலாம் விட்டு அகன்று","சொல்லுமட்டும் சிந்தை செலுத்துவது எக்காலம்? 10"]},{"n":102,"label":"102","section":"ஒலிபடரும் கு","lines":["மேலாம் பதம்தேடி மெய்ப்பொருளை உள்இருத்தி","நாலாம் பதம் தேடி நான் பெறுவது எக்காலம்?"]},{"n":103,"label":"103","section":"ஒலிபடரும் கு","lines":["எண்ணாத தூரம் எல்லாம் எண்ணி எண்ணிப் பாராமல்","கண்ணாடிக்குள் ஒளிபோல கண்டறிவது எக்காலம் ?"]},{"n":104,"label":"104","section":"ஒலிபடரும் கு","lines":["என்னை அறிந்து கொண்டே எங்கோமானோடு இருக்கும்","தன்மை அறிந்து சமைந்திருப்பது எக்காலம்?"]},{"n":105,"label":"105","section":"ஒலிபடரும் கு","lines":["ஆறு ஆதாரம் கடந்த ஆனந்தப் பேரொளியை","பேறாகக் கண்டு நான் பெற்றிருப்பது எக்காலம்?"]},{"n":106,"label":"106","section":"ஒலிபடரும் கு","lines":["ஆணவ மாயத்தால் அழிந்து உடலம் போகாமுன்","காணுதலால் இன்பமற்றுக் கண்டறிவது எக்காலம்?"]},{"n":107,"label":"107","section":"ஒலிபடரும் கு","lines":["மும்மலமும் சேர்ந்து முளைத்தெழுந்த காயம் இதை","நில்மலமாய்க் கண்டு வினை நீங்கி இருப்பது எக்காலம்?"]},{"n":108,"label":"108","section":"ஒலிபடரும் கு","lines":["முன்னை வினை கெடவே மூன்று வகைக் காட்சியினால்","உன்னை வெளிப்படுத்தி உறுவது இனி எக்காலம்?"]},{"n":109,"label":"109","section":"ஒலிபடரும் கு","lines":["கண்ணின் ஒளி பாய்ந்ததுவும் கருத்தறிந்து கொண்டதுவும்","விண்ணின் ஒளி கண்டதுவும் வெளிப்படுவதும் எக்காலம்?"]},{"n":110,"label":"110","section":"ஒலிபடரும் கு","lines":["கனவு கண்டால் போல் எனக்குக் காட்டி மறைத்தே இருக்க","நினைவைப் பரவெளியில் நிறுத்துவது எக்காலம்?"]},{"n":111,"label":"111","section":"ஒலிபடரும் கு","lines":["ஆர் என்று கேட்டதுவும் அறிவு வந்து கண்டதுவும்","பார் என்று சொன்னதுவும் பகுத்தறிவது எக்காலம்?"]},{"n":112,"label":"112","section":"ஒலிபடரும் கு","lines":["நினைக்கும் நினைவுதோறும் நிறைந்த பரிபூரணத்தை","முனைக்குமேல் கண்டு கண்ணில் முத்துதிர்ப்பது எக்காலம்?"]},{"n":113,"label":"113","section":"ஒலிபடரும் கு","lines":["முப்பாழும் பாழாய், முதற்பாழும் சூனியமாய்","அப்பாழும் பாழாய் அன்பு செய்வது எக்காலம்?"]},{"n":114,"label":"114","section":"ஒலிபடரும் கு","lines":["சீ யென்று எழுந்து தெளிந்து நின்ற வான் பொருளை","நீ யென்று கண்டு நிலை பெறுவது எக்காலம்?"]},{"n":115,"label":"115","section":"ஒலிபடரும் கு","lines":["வவ்வெழுத்தும் மவ்வெழுத்தும் வாளாகும் சிவ்வெழுத்தும்","அவ்வெழுத்தின் உள்ளே அடங்கி நிற்பது எக்காலம்?"]},{"n":116,"label":"116","section":"ஒலிபடரும் கு","lines":["எழுத்தெல்லாம் மாண்டிறந்தே ஏகமாய் நின்றதிலே","அழுத்தமாய்ச் சிந்தையை வைத்தன்பு கொள்வது எக்காலம்?"]},{"n":117,"label":"117","section":"ஒலிபடரும் கு","lines":["அருளாய் உருவாகி ஆதி அந்தம் ஆகின்ற","குருவாக வந்து எனை ஆட்கொண்டு அருள்வது எக்காலம்?"]},{"n":118,"label":"118","section":"ஒலிபடரும் கு","lines":["நான் என்று அறிந்தவனை நான் அறியாக் காலம் எல்லாம்","தான் என்று நீ இருந்ததனை அறிவது எக்காலம்?"]},{"n":119,"label":"119","section":"ஒலிபடரும் கு","lines":["என் மயமாய்க் கண்டதெல்லாம் எண்ணி எண்ணிப் பார்த்த பின்பு","தன் மயமாய்க் கொண்டதிலே சார்ந்து நிற்பது எக்காலம்?"]},{"n":120,"label":"120","section":"ஒலிபடரும் கு","lines":["ஒளியில் ஒளியாம் உருப்பிறந்த வாறதுபோல்","வெளியில் வெளியான விதம் அறிவது எக்காலம்?"]},{"n":121,"label":"121","section":"ஒலிபடரும் கு","lines":["ஒளிஇட்ட மெய்ப்பொருளை உள் வழியிலே அடைத்து","வெளியிட்டுச் சாத்திவைத்து வீடு உறுவது எக்காலம்?"]},{"n":122,"label":"122","section":"ஒலிபடரும் கு","lines":["காந்தம் வலித்து இரும்பைக் கரத்திழுத்துக் கொண்டதுபோல்","பாய்ந்து பிடித்திழுத்துன் பாதத்தில் வைப்பது எக்காலம்?"]},{"n":123,"label":"123","section":"ஒலிபடரும் கு","lines":["பித்தாயம் கொண்டு பிரணவத்தை ஊடறுத்துச்","செந்தாரைப் போலே திரிவது இனி எக்காலம்?"]},{"n":124,"label":"124","section":"ஒலிபடரும் கு","lines":["ஒழிந்த கருத்தினை வைத்து உள் எலும்பு வெள் எலும்பாய்க்","கழிந்த பிணம் போல் இருந்து காண்பது இனி எக்காலம்?"]},{"n":125,"label":"125","section":"ஒலிபடரும் கு","lines":["ஆதிகபிலர் சொன்ன ஆகமத்தின் சொற்படியே","சாதிவகை இல்லாமல் சஞ்சரிப்பது எக்காலம்?"]},{"n":126,"label":"126","section":"ஒலிபடரும் கு","lines":["சூதும் களவும் தொடர்வினையும் சுட்டிக் காற்று","ஊதும் துருத்தியைப் போட்டு உனை அடைவது எக்காலம்?"]},{"n":127,"label":"127","section":"ஒலிபடரும் கு","lines":["ஆசைவலைப் பாசத்து அகப்பட்டு மாயாமல்","ஓசைமணித் தீபத்தில் ஒன்றி நிற்பது எக்காலம்?"]},{"n":128,"label":"128","section":"ஒலிபடரும் கு","lines":["கல்லாய் மரமாய்க் கயலாய்ப் பறவைகளாய்ப்","புல்லாய் பிறந்த சென்மம் போதும் என்பது எக்காலம்?"]},{"n":129,"label":"129","section":"ஒலிபடரும் கு","lines":["தக்கும் வகைக்கோர் பொருளும் சாராமலே நினைவில்","பக்குவமாய் நின் அருளைப் பார்த்திருப்பது எக்காலம்?"]},{"n":130,"label":"130","section":"ஒலிபடரும் கு","lines":["தூரோடு அசைந்து சுழன்று வரும் தத்துவத்தை","வேரோடு இசைந்து விளங்குவதும் எக்காலம்?"]},{"n":131,"label":"131","section":"ஒலிபடரும் கு","lines":["பாகம் நடு மாறிப் பயந்தெழுந்த சித்திரத்தை","ஏகநடு மூலத்து இருத்துவதும் எக்காலம்?"]},{"n":132,"label":"132","section":"ஒலிபடரும் கு","lines":["ஓரின்பம் காட்டும் உயர்ஞான வீதி சென்று","பேரின்ப வீடுகண்டு பெற்றிருப்பது எக்காலம்?"]},{"n":133,"label":"133","section":"ஒலிபடரும் கு","lines":["காரணமாய் வந்து என் கருத்தில் உரைத்ததெல்லாம்","பூரணமாக் கண்டு புகழ்ந்திருப்பது எக்காலம்?"]},{"n":134,"label":"134","section":"ஒலிபடரும் கு","lines":["ஆயும் கலைகள் எல்லாம் ஆராய்ந்து பார்த்ததன்பின்","நீ என்றும் இல்லா நிசம் காண்பது எக்காலம்?"]},{"n":135,"label":"135","section":"ஒலிபடரும் கு","lines":["குறியாகக் கொண்டு குலம் அளித்த நாயகனைப்","பிரியாமல் சேர்ந்து பிறப்பறுப்பது எக்காலம்?"]},{"n":136,"label":"136","section":"ஒலிபடரும் கு","lines":["மத்தடுத்து நின்ற மருள் ஆடு வார் போல","பித்தடுத்து நின் அருளைப் பெற்றிருப்பது எக்காலம்?"]},{"n":137,"label":"137","section":"ஒலிபடரும் கு","lines":["சாவாமல் செத்திருந்து சற்குருவின் பொன் அடிக்கீழ்","வேகாமல் வெந்திருக்க வேண்டுவதும் எக்காலம்?"]},{"n":138,"label":"138","section":"ஒலிபடரும் கு","lines":["என்னை அறியாமல் இருந்து ஆட்டும் சூத்திரநின்","தன்னை அறிந்து தவம் பெறுவது எக்காலம்?"]},{"n":139,"label":"139","section":"ஒலிபடரும் கு","lines":["உள்ளம் அறியாது ஒளித்திருந்த நாயகனை","கள்ள மனம் தெளிந்துகாண்பது இனி எக்காலம்?"]},{"n":140,"label":"140","section":"ஒலிபடரும் கு","lines":["வாசித்தும் காணாமல் வாய்விட்டும் பேசாமல்","பூசித்தும் தோன்றாப் பொருள் காண்பது எக்காலம்?"]},{"n":141,"label":"141","section":"ஒலிபடரும் கு","lines":["பன்னிரண்டு கால்புரவி பாய்ந்து சில்லம் தட்டாமல்","பின் இரண்டு சங்கிலிக்குள் பிணிப்பது இனி எக்காலம்?"]},{"n":142,"label":"142","section":"ஒலிபடரும் கு","lines":["நாட்டுக்கால் இரண்டும்விட்டு நடுவுக்கால் ஊடேபோய்","ஆட்டுக்கால் இரண்டினுள்ளே அமர்ந்திருப்பது எக்காலம்?"]},{"n":143,"label":"143","section":"ஒலிபடரும் கு","lines":["பாற்சுவைப் பூட்டிப் பதியில் வைத்துச் சீராட்டிக்","காற்பசுவை ஓட்டி அதில் கட்டி வப்பது எக்காலம்?"]},{"n":144,"label":"144","section":"ஒலிபடரும் கு","lines":["பல இடத்தே மனதைப் பாயவிட்டுப் பாராமல்","நிலவரையின் ஊடேபோய் நேர்படுவது எக்காலம்?"]},{"n":145,"label":"145","section":"ஒலிபடரும் கு","lines":["காமக் கடல்கடந்து கரைஏறிப் போவதற்கே","ஓமக் கனல்வளர்த்தி உள்ளிருப்பது எக்காலம்?"]},{"n":146,"label":"146","section":"ஒலிபடரும் கு","lines":["உதயச் சுடர் மூன்றும் உள்வீட்டி லே கொளுத்தி","இதயத் திருநடனம் இனிக்காண்பது எக்காலம்?"]},{"n":147,"label":"147","section":"ஒலிபடரும் கு","lines":["வேதாந்த வேதம் எல்லாம் வீட்டேறியே கடந்து","நாதாந்த மூல நடு இருப்பது எக்காலம்?"]},{"n":148,"label":"148","section":"ஒலிபடரும் கு","lines":["பட்டம் அற்றுக் காதற்றில் பறந்தாடும் சூத்திரம் போல்","வெட்டு வெளியாக விசும்பறிதல் எக்காலம்?"]},{"n":149,"label":"149","section":"ஒலிபடரும் கு","lines":["அட்டாங்கயோகம் அதற்கப்பாலுக் கப்பாலாய்","கிட்டாப் பொருள் அதனைக் கிட்டுவதும் எக்காலம்?"]},{"n":150,"label":"150","section":"ஒலிபடரும் கு","lines":["ஒட்டாமல் ஒட்டிநிற்கும் உடலும் உயிரும்பிரிந்தே","எட்டாப் பழம்பதிக்கு இங்கு ஏணிவைப்பது எக்காலம்?"]},{"n":151,"label":"151","section":"ஒலிபடரும் கு","lines":["பாசத்தை நீக்கி பசுவைப் பதியில்விட்டு","நேசத்தின் உள்ளே நினைந்திருப்பது எக்காலம்?"]},{"n":152,"label":"152","section":"ஒலிபடரும் கு","lines":["ஆசார நேச அனுட்டானமும் மறந்து","பேசாமெய்ஞ் ஞானநிலை பெற்றிருப்பது எக்காலம்?"]},{"n":153,"label":"153","section":"ஒலிபடரும் கு","lines":["பல்லாயிரம் கோடிப் பகிரண்டம் உம்படைப்பே","அல்லாது வேறில்லை என்று அறிவது இனி எக்காலம்?"]},{"n":154,"label":"154","section":"ஒலிபடரும் கு","lines":["ஆதிமுதல் ஆகிநின்ற அரிஎன்ற அட்சரத்தை","ஓதி அறிந்துள்ளே உணர்வது இனி எக்காலம்?"]},{"n":155,"label":"155","section":"ஒலிபடரும் கு","lines":["சாத்திரத்தைச் சுட்டுச் சதுர்மறையைப் பொய்யாக்கிச்","சூத்திரத்தைக் கண்டு துயர் அறுப்பது எக்காலம்?"]},{"n":156,"label":"156","section":"ஒலிபடரும் கு","lines":["அல்லும் பகலும் என்றன் அறிவை அறிவால் அறிந்து","சொல்லும் உரைமறந்து தூங்குவதும் எக்காலம்?"]},{"n":157,"label":"157","section":"ஒலிபடரும் கு","lines":["இயங்கும் சராசரத்தில் எள்ளும் எண்ணெ யும்போல","முயங்கும் அந்த வேத முடிவு அறிவது எக்காலம்?"]},{"n":158,"label":"158","section":"ஒலிபடரும் கு","lines":["ஊனாகி ஊனில் உயிராகி எவ்வுலகும்","தானாகி நின்றதனை அறிவது எக்காலம்?"]},{"n":159,"label":"159","section":"ஒலிபடரும் கு","lines":["என்னை விட்டு நீங்காமல் என்னிடத்து நீ இருக்க","உன்னை விட்டு நீங்காது ஒருப்படுவது எக்காலம்?"]},{"n":160,"label":"160","section":"ஒலிபடரும் கு","lines":["இன்னதென்று சொல்லஒண்ணா எல்லையற்ற வான் பொருளைச்","சொன்னதென்று நான் அறிந்து சொல்வது இனி எக்காலம்?"]},{"n":161,"label":"161","section":"ஒலிபடரும் கு","lines":["மனதைஒரு வில்லாக்கி வான்பொறியை நாணாக்கி","என தறிவைஅம்பாக்கி எய்வது இனி எக்காலம்?"]},{"n":162,"label":"162","section":"ஒலிபடரும் கு","lines":["என்னை இறக்கஎய்தே என்பழியை ஈடழித்த","உன்னை வெளியில் வைத்தேஒளித்து நிற்பது எக்காலம்?"]},{"n":163,"label":"163","section":"ஒலிபடரும் கு","lines":["கடத்துகின்ற தோணிதனைக் கழைகள் குத்தி விட்டாற்போல்","நடத்துகின்ற சித்திரத்தை நான்அறிவது எக்காலம்?"]},{"n":164,"label":"164","section":"ஒலிபடரும் கு","lines":["நின்றநிலை பேராமல், நினைவில்ஒன்றும் சாராமல்","சென்றநிலை முத்தி என்று சேர்ந்தறிவது எக்காலம்?"]},{"n":165,"label":"165","section":"ஒலிபடரும் கு","lines":["பொன்னும் வெள்ளியும் பூண்ட பொற்பதத்தைஉள் அமைத்து","மின்னும் ஒளிவெளியே விட்டு அடைப்பது எக்காலம்?"]},{"n":166,"label":"166","section":"ஒலிபடரும் கு","lines":["கூட்டில் அடைப்பட்ட புழு குளவி உருக்கொண்டதுபோல்","வீட்டில்அடை பட்டுஅருளை வேண்டுவதும் எக்காலம்?"]},{"n":167,"label":"167","section":"ஒலிபடரும் கு","lines":["கடலில்ஒளித்திருந்த கனல்எழுந்து வந்தாற்போல்","உடலில்ஒளித்த சிவம்ஒளி செய்வது எக்காலம்?"]},{"n":168,"label":"168","section":"ஒலிபடரும் கு","lines":["அருணப் பிரகாசம் அண்டஎங்கும் போர்த்தது போல்","கருணைத் திருவடியில் கலந்து நிற்பது எக்காலம்?"]},{"n":169,"label":"169","section":"ஒலிபடரும் கு","lines":["பொன்னில் பலவிதமாம் பூடணம்உண்டானது போல்","உன்னில் பிறந்து உன்னில்ஒடுங்குவதும் எக்காலம்?"]},{"n":170,"label":"170","section":"ஒலிபடரும் கு","lines":["நாயிற் கடைப்பிறப்பால் நான்பிறந்த துன்பம்அற","வேயில் கனல் ஒளிபோல் விளங்குவதும் எக்காலம்?"]},{"n":171,"label":"171","section":"ஒலிபடரும் கு","lines":["சூரியகாந்தி ஒளி சூழ்ந்து பஞ்சைச் சுட்டதுபோல்","ஆரியந்தோற்றத்து அருள் பெறுவது எக்காலம்?"]},{"n":172,"label":"172","section":"ஒலிபடரும் கு","lines":["இரும்பினில் கனல்மூட்டி இவ்வுருபோய் அவ்வுருவாய்க்","கரும்பில் சுவைரசத்தைக் கண்டறிவது எக்காலம்?"]},{"n":173,"label":"173","section":"ஒலிபடரும் கு","lines":["கருக்கொண்ட முட்டைதனைக் கடல் ஆமைதான் நினைக்க","உருக்கொண்ட வாறதுபோல்உனை அடைவது எக்காலம்?"]},{"n":174,"label":"174","section":"ஒலிபடரும் கு","lines":["வீடுவிட்டு பாய்ந்து வெளியில் வருவார்போல்","கூடுவிட்டுப் பாயும் குறிப்பறிவது எக்காலம்?"]},{"n":175,"label":"175","section":"ஒலிபடரும் கு","lines":["கடைந்த வெண்ணய் மோரில் கலவாதவாறதுபோல்","உடைந்து தமியேன் உனைக்காண்பது எக்காலம்?"]},{"n":176,"label":"176","section":"ஒலிபடரும் கு","lines":["இருளை ஒளி விழுங்கி ஏகஉருக் கொண்டாற்போல்","அருளை விழுங்கும்இருள் அகன்று நிற்பது எக்காலம்?"]},{"n":177,"label":"177","section":"ஒலிபடரும் கு","lines":["மின் எழுந்து மின்ஒடுங்கி விண்ணில் உறைந்தாற்போல்","என்னுள் நின்றதுஎன்னுள்ளே யான் அறிவது எக்காலம்?"]},{"n":178,"label":"178","section":"ஒலிபடரும் கு","lines":["கண்ட புனல்குடத்தில் கதிர் ஒளிகள் பாய்ந்தாற்போல்","கொண்ட சொரூபமதைக் கூர்ந்தறிவது எக்காலம்?"]},{"n":179,"label":"179","section":"ஒலிபடரும் கு","lines":["பூணுகின்ற பொன் அணிந்தால் பொன்சுமக்குமோ உடலை","காணுகின்றஎன் கருத்தில் கண்டறிவது எக்காலம்?"]},{"n":180,"label":"180","section":"ஒலிபடரும் கு","lines":["செம்பில் களிம்புபோல் சிவத்தைவிழுங்கி மிக","வெம்பி நின்ற மும்மலத்தை வேறுசெய்வது எக்காலம்?"]},{"n":181,"label":"181","section":"ஒலிபடரும் கு","lines":["ஆவியும் காயமும்போல் ஆத்துமத்தில் நின்றதனை","பாவிஅறிந்து மனம் பற்றி நிற்பது எக்காலம்?"]},{"n":182,"label":"182","section":"ஒலிபடரும் கு","lines":["ஊமை கனாக்கண்டு உரைக்கஅறியா இன்பம்அதை","நாம்அறிந்து கொள்வதற்கு நாள் வருவதுஎக்காலம்?"]},{"n":183,"label":"183","section":"ஒலிபடரும் கு","lines":["சாகாச் சிவனடியைத் தப்பாதார் எப்போதும்","போகா உடல்அகன்று போவதென்பது எக்காலம்?"]},{"n":184,"label":"184","section":"ஒலிபடரும் கு","lines":["நிட்டைதனை விட்டு நினைவறிவு தப்பவிட்டு","வெட்ட வெளியில்விரவி நிற்பது எக்காலம்?"]},{"n":185,"label":"185","section":"ஒலிபடரும் கு","lines":["வெட்டவெளி தன்னில்விளைந்த வெறும் பாழ்","திட்டமுடன் கண்டு தெளிவது இனி எக்காலம்?"]},{"n":186,"label":"186","section":"ஒலிபடரும் கு","lines":["எங்கும் பரவடிவாய் என் வடிவு நின் வடிவாய்க்","கங்குல்பகல் இன்றிஉனைக் கண்டிருப்பது எக்காலம்?"]},{"n":187,"label":"187","section":"ஒலிபடரும் கு","lines":["உண்டதுவும் மாதருடன் கூடிச்சேர்ந்து இன்பம்","கண்டதுவும் நீயெனவேகண்டு கொள்வது எக்காலம்?"]},{"n":188,"label":"188","section":"ஒலிபடரும் கு","lines":["ஈம்என்று கேட்டதுவும் என்னுள்ளே நின்றதுவும்","ஓம்என்று சொன்னதுவும் உற்றறிவது எக்காலம்?"]},{"n":189,"label":"189","section":"ஒலிபடரும் கு","lines":["சத்தம் பிறந்த இடம் தன் மயமாய் நின்ற இடம்","சித்தம் பிறந்தஇடம் தேர்ந்தறிவது எக்காலம்?"]},{"n":190,"label":"190","section":"ஒலிபடரும் கு","lines":["போக்கு வரவும் புறம்புள்ளும் ஆகிநின்றும்","தாக்கும் ஒரு பொருளைச் சந்திப்பது எக்காலம்?"]},{"n":191,"label":"191","section":"ஒலிபடரும் கு","lines":["நான் எனவும் நீ எனவும் நாம் இரண்டு மற்றொன்றும்","நீ எனவே சிந்தைதனில் நேர்படுவது எக்காலம்?"]},{"n":192,"label":"192","section":"ஒலிபடரும் கு","lines":["அறிவை அறிவால் அறிந்தே அறிவும் அறிவுதனில்","பிறிவுபட நில்லாமல் பிடிப்பதுஇனி எக்காலம்?"]},{"n":193,"label":"193","section":"ஒலிபடரும் கு","lines":["நீடும் புவனம் எல்லாம் நிறைந்துசிந் தூரம் அதாய்","ஆடும் திருக்கூத்தை அறிவது இனி எக்காலம்?"]},{"n":194,"label":"194","section":"ஒலிபடரும் கு","lines":["தித்தி என்ற கூத்தும் திருச்சிலம்பின் ஓசைகளும்","பத்தியுடனே கேட்டுப் பணிவது இனி எக்காலம்?"]},{"n":195,"label":"195","section":"ஒலிபடரும் கு","lines":["நயனத்திடை வெளிபோல் நண்ணும் பரவெளியில்","சயனித் திருந்து தலைப்படுவது எக்காலம்?"]},{"n":196,"label":"196","section":"ஒலிபடரும் கு","lines":["அருவி மலைநடுவே ஆயிரக்கால் மண்டபத்தில்","திருவிளையாடல்கண்டு தெரிசிப்பது எக்காலம்?"]},{"n":197,"label":"197","section":"ஒலிபடரும் கு","lines":["மீனை மிக உண்டு நக்கி விக்கி நின்ற கொக்கதுபோல்","தேனைமிக உண்டு தெவிட்டி நிற்பது எக்காலம்?"]},{"n":198,"label":"198","section":"ஒலிபடரும் கு","lines":["பொல்லாத காயம் அதைப் போட்டு விடுக்குமுன்னே","கல் ஆவின் பால்கறப்பக் கற்பது இனி எக்காலம்?"]},{"n":199,"label":"199","section":"ஒலிபடரும் கு","lines":["வெட்ட வெளிக்குள்ளே விளங்கும் சதாசிவத்தைக்","கிட்டவரத் தேடிக் கிருபை செய்வது எக்காலம்?"]},{"n":200,"label":"200","section":"ஒலிபடரும் கு","lines":["பேரறிவிலே மனதைப் பேராமலே இருத்தி","ஓரறிவில் என்னாளும் ஊன்றி நிற்பது எக்காலம்?"]},{"n":201,"label":"201","section":"ஒலிபடரும் கு","lines":["அத்துவிதம் போலும் என்றன் ஆத்துமத்தின் உள்ளிருந்து","முத்தி தர நின்றமுறை அறிவது எக்காலம்?"]},{"n":202,"label":"202","section":"ஒலிபடரும் கு","lines":["நான்நின்ற பாசம்அதில் நான்இருந்து மாளாமல்","நீநின்ற கோலம்அதில் நிரவிநிற்பது எக்காலம்?"]},{"n":203,"label":"203","section":"ஒலிபடரும் கு","lines":["எள்ளும்கரும்பும் எழில்மலரும் காயமும்போல்","உள்ளும் புறம்புநின்று உற்றறிவது எக்காலம்?"]},{"n":204,"label":"204","section":"ஒலிபடரும் கு","lines":["அன்னம் புனலை வகுத்து அமிர்தத்தை உண்பதுபோல்","என்னை வகுத்து உன்னை இனிக்காண்பது எக்காலம்?"]},{"n":205,"label":"205","section":"ஒலிபடரும் கு","lines":["அந்தரத்தில் நீர்பூத்து அலர்ந்தெழுந்த தாமரைபோல்","சிந்தை வைத்துக் கொண்டு தெரிசிப்பது எக்காலம்?"]},{"n":206,"label":"206","section":"ஒலிபடரும் கு","lines":["பிறப்பும் இறப்பும்அற்றுப் பேச்சும்அற்று மூச்சும்அற்று","மறப்பும் நினைப்பும்அற்று மாண்டிருப்பது எக்காலம்?"]},{"n":207,"label":"207","section":"ஒலிபடரும் கு","lines":["மன்னும் பரவெளியை மனவெளியில் அடைத்துஅறிவை","என்னுள் ஒருநினைவை எழுப்பிநிற்பது எக்காலம்?"]},{"n":208,"label":"208","section":"ஒலிபடரும் கு","lines":["ஆசை கொண்ட மாதர் அடைகனவு நீக்கி உன்மேல்","ஓசை கொண்டு நானும் ஒடுங்குவதும் எக்காலம்?"]},{"n":209,"label":"209","section":"ஒலிபடரும் கு","lines":["தன்உயிரைக் கொண்டு தான் திரிந்த வாறதுபோல்","உன்உயிரைக் கொண்டு இங்கு ஒடுங்குவதும் எக்காலம்?"]},{"n":210,"label":"210","section":"ஒலிபடரும் கு","lines":["சேற்றில் கிளை நாட்டும் திடமாம் உடலைஇனிக்","காற்றில்உழல் சூத்திரமாய் காண்பது இனி எக்காலம்?"]},{"n":211,"label":"211","section":"ஒலிபடரும் கு","lines":["என் வசமும்கெட்டு இங்கிருந்த வசமும் அழிந்து","தன்வசமும் கெட்டு அருளைச் சார்ந்து இருப்பது எக்காலம்?"]},{"n":212,"label":"212","section":"ஒலிபடரும் கு","lines":["தன்னை மறந்து தலத்து நிலை மறந்து","கன்மம் மறந்து கதி பெறுவது எக்காலம்?"]},{"n":213,"label":"213","section":"ஒலிபடரும் கு","lines":["என்னை என்னிலே மறந்தே இருந்த பதியும் மறந்து","தன்னையும் தானே மறந்து தனித்து இருப்பது எக்காலம்?"]},{"n":214,"label":"214","section":"ஒலிபடரும் கு","lines":["தன்னையும் தானே மறந்து தலைவாசல் தாழ்போட்டே","உன்னை நினைந்துள்ளே உறங்குவதும் எக்காலம்?"]},{"n":215,"label":"215","section":"ஒலிபடரும் கு","lines":["இணை பிரிந்தபோதல் இன்பமுறும் அன்றிலைப்போல்","துணை பிரிந்தபோது அருள் தூல்தொடர்ந்து கொள்வது எக்காலம்?"]},{"n":216,"label":"216","section":"ஒலிபடரும் கு","lines":["ஆட்டம்ஒன்றும் இல்லாமல் அசைவு சற்றும் காணாமல்","தேட்டம் அற்ற வான்பொருளைத்தேடுவதும் எக்காலம்?"]},{"n":217,"label":"217","section":"ஒலிபடரும் கு","lines":["முன்னை வினையால் அறிவுமுற்றாமல் பின் மறைந்தால்","அன்னை தனைத்தேடி அமுதுண்பது எக்காலம்?"]},{"n":218,"label":"218","section":"ஒலிபடரும் கு","lines":["கள்ளுண்டவர்போல் களிதரும் ஆனந்தம்அதால்","தள்ளுண்டு நின்றாடித் தடைப்படுவது எக்காலம்?"]},{"n":219,"label":"219","section":"ஒலிபடரும் கு","lines":["நான் அவனாய்க் காண்பதெல்லாம்ஞானவிழியா ல்அறிந்து","தான் அவனாய் நின்று சரண் அடைவது எக்காலம்?"]},{"n":220,"label":"220","section":"ஒலிபடரும் கு","lines":["தான் அந்தம் இல்லாத தற்பரத்தின் ஊடுருவில்","ஆனந்தம் கண்டே அமர்ந்திருப்பது எக்காலம்?"]},{"n":221,"label":"221","section":"ஒலிபடரும் கு","lines":["உற்ற வெளிதனிலே உற்றுப் பார்த்து அந்தரத்தே","மற்றமற மாய்கை மாள்வது இனி எக்காலம்?"]},{"n":222,"label":"222","section":"ஒலிபடரும் கு","lines":["ஏடலர்ந்து பங்கயமும் இருகருணை நேத்திரமும்","தோடணிந்த குண்டலமும் தோன்றுவதும் எக்காலம்?"]},{"n":223,"label":"223","section":"ஒலிபடரும் கு","lines":["ஐயாறும் ஆறும் அகன்று வெறுவெளியில்","மை இருளில் நின்ற மனம் மாள்வது இனி எக்காலம்?"]},{"n":224,"label":"224","section":"ஒலிபடரும் கு","lines":["காட்டும்அருள் ஞானக்கடலில் அன்புக் கப்பல்விட்டு","மூட்டும் கருணைக் கடலில் மூழ்குவதும் எக்காலம்?"]},{"n":225,"label":"225","section":"ஒலிபடரும் கு","lines":["நான் யாரோ நீ யாரோ நன்றாம் பரமான","தான் யாரோ என்றுஉணர்ந்து தவம்முடிப்பது எக்காலம்?"]},{"n":226,"label":"226","section":"ஒலிபடரும் கு","lines":["எவர் எவர்கள் எப்படிக் கண்டுஎந்தப்படி நினைத்தார்","அவர் அவர்க்குஅப்படி நின்றாய் என்பது எக்காலம்?"]},{"n":227,"label":"227","section":"ஒலிபடரும் கு","lines":["உற்றுற்றுப் பார்க்க ஒளிதரும் ஆனந்தம்அதை","நெற்றிக்கு நேர்கண்டு நிலைப்பது இனி எக்காலம்?"]},{"n":228,"label":"228","section":"ஒலிபடரும் கு","lines":["விளங்குகின்ற தாரகையை வெய்யோன் மறைத்தாற்போல்","களங்கமற உன்காட்சி கண்டறிவது எக்காலம்?"]},{"n":229,"label":"229","section":"ஒலிபடரும் கு","lines":["என்னையே நான் அறியேன் இந்த வண்ணம் சொன்ன தெல்லாம்","முன்னையோர் கைக்கொள்ள முன்பணிவது எக்காலம்?"]},{"n":230,"label":"230","section":"ஒலிபடரும் கு","lines":["மாயத்தை நீக்கி வருவினையைப் பாழாக்கி","காயத்தை வேறாக்கி காண்பதுஉனை எக்காலம்?"]},{"n":231,"label":"231","section":"ஒலிபடரும் கு","lines":["ஐஞ்சு கரத்தானை அடி இணையைப் போற்றிசெய்து","நெஞ்சில் பொருத்தி நிலைபெறுவது எக்காலம்?"]}]}