{"id":"kudhambai-padalgal","siddhar":"kudhambai","titleTa":"குதம்பைச் சித்தர் பாடல்கள்","titleEn":"Kudhambai Siddhar Songs","source":["pm0076"],"verses":[{"n":1,"label":"1","section":"கண்ணிகள்","lines":["வெட்ட வெளிதன்னை மெய்யென்று இருப்போர்க்குப்","பட்டயம் ஏதுக்கடி - குதம்பாய்","பட்டயம் ஏதுக்கடி ?"]},{"n":2,"label":"2","section":"கண்ணிகள்","lines":["மெய்ப்பொருள் கண்டு விளங்கும்மெய்ஞ் ஞானிக்குக்","கற்பங்கள் ஏதுக்கடி - குதம்பாய்","கற்பங்கள் ஏதுக்கடி ?"]},{"n":3,"label":"3","section":"கண்ணிகள்","lines":["காணாமற் கண்டு கருத்தோடு இருப்போர்க்கு","வீணாசை ஏதுக்கடி - குதம்பாய்","வீணாசை ஏதுக்கடி ?"]},{"n":4,"label":"4","section":"கண்ணிகள்","lines":["வஞ்சகம் அற்று வழிதன்னைக் கண்டோர்க்குச்","சஞ்சலம் ஏதுக்கடி - குதம்பாய்","சஞ்சலம் ஏதுக்கடி ?"]},{"n":5,"label":"5","section":"கண்ணிகள்","lines":["ஆதாரமான அடிமுடி கண்டோர்க்கு","வாதாட்டம் ஏதுக்கடி - குதம்பாய்","வாதாட்டம் ஏதுக்கடி ?"]},{"n":6,"label":"6","section":"கண்ணிகள்","lines":["நித்திரை கெட்டு நினைவோடு இருப்போர்க்கு","முத்திரை ஏதுக்கடி - குதம்பாய்","முத்திரை ஏதுக்கடி ?"]},{"n":7,"label":"7","section":"கண்ணிகள்","lines":["தந்திரமான தலந்தனில் நிற்போர்க்கு","மந்திரம் ஏதுக்கடி - குதம்பாய்","மந்திரம் ஏதுக்கடி ?"]},{"n":8,"label":"8","section":"கண்ணிகள்","lines":["சத்தியமான தவத்தில் இருப்போர்க்கு","உத்தியம் ஏதுக்கடி - குதம்பாய்","உத்தியம் ஏதுக்கடி ?"]},{"n":9,"label":"9","section":"கண்ணிகள்","lines":["நாட்டத்தைப் பற்றி நடுவணை சேர்வோர்க்கு","வாட்டங்கள் ஏதுக்கடி - குதம்பாய்","வாட்டங்கள் ஏதுக்கடி ?"]},{"n":10,"label":"10","section":"கண்ணிகள்","lines":["முத்தமிழ் கற்று முயங்குமெய்ஞ் ஞானிக்குச்","சத்தங்கள் ஏதுக்கடி - குதம்பாய்","சத்தங்கள் ஏதுக்கடி ?"]},{"n":11,"label":"11","section":"கண்ணிகள்","lines":["உச்சிக்கு மேற்சென்று உயர்வெளி கண்டோர்க்கு","இச்சிப்பிங்கு ஏதுக்கடி - குதம்பாய்","இச்சிப்பிங்கு ஏதுக்கடி ?"]},{"n":12,"label":"12","section":"கண்ணிகள்","lines":["வேகாமல் வெந்து வெளியெளி கண்டோர்க்கு","மோகாந்தம் ஏதுக்கடி - குதம்பாய்","மோகாந்தம் ஏதுக்கடி ?"]},{"n":13,"label":"13","section":"கண்ணிகள்","lines":["சாகாமல் தாண்டித் தனிவழி போவோர்க்கு","ஏகாந்தம் ஏதுக்கடி - குதம்பாய்","ஏகாந்தம் ஏதுக்கடி ?"]},{"n":14,"label":"14","section":"கண்ணிகள்","lines":["அந்தரந் தன்னில் அசைந்தாடு முத்தர்க்குத்","தந்திரம் ஏதுக்கடி - குதம்பாய்","தந்திரம் ஏதுக்கடி ?"]},{"n":15,"label":"15","section":"கண்ணிகள்","lines":["ஆனந்தம் பொங்கி அறிவோடு இருப்பார்க்கு","ஞானந்தான் ஏதுக்கடி - குதம்பாய்","ஞானந்தான் ஏதுக்கடி ?"]},{"n":16,"label":"16","section":"கண்ணிகள்","lines":["சித்தரக் கூடத்தைத் தினந்தினம் காண்போர்க்குப்","பத்திரம் ஏதுக்கடி - குதம்பாய்","பத்திரம் ஏதுக்கடி ?"]},{"n":17,"label":"17","section":"கண்ணிகள்","lines":["முக்கோணம் தன்னில் முளைத்தமெய்ஞ் ஞானிக்குச்","சட்கோணம் ஏதுக்கடி - குதம்பாய்","சட்கோணம் ஏதுக்கடி ?"]},{"n":18,"label":"18","section":"கண்ணிகள்","lines":["அட்டதிக்கெல்லாம் அசைந்தாடும் நாதர்க்கு","நட்டணை ஏதுக்கடி - குதம்பாய்","நட்டணை ஏதுக்கடி ?"]},{"n":19,"label":"19","section":"கண்ணிகள்","lines":["முத்தி பெற்றுள்ளம் முயங்குமெய்ஞ் ஞானிக்குப்","பத்தியம் ஏதுக்கடி - குதம்பாய்","பத்தியம் ஏதுக்கடி ?"]},{"n":20,"label":"20","section":"கண்ணிகள்","lines":["அல்லலை நீக்கி அறிவோடு இருப்போருக்குப்","பல்லாக்கு ஏதுக்கடி - குதம்பாய்","பல்லாக்கு ஏதுக்கடி ?"]},{"n":21,"label":"21","section":"கண்ணிகள்","lines":["அட்டாங்க யோகம் அறிந்தமெய்ஞ் ஞானிக்கு","முட்டாங்கம் ஏதுக்கடி - குதம்பாய்","முட்டாங்கம் ஏதுக்கடி ?"]},{"n":22,"label":"22","section":"கண்ணிகள்","lines":["வேகம் அடக்கி விளங்குமெய்ஞ் ஞானிக்கு","யோகந்தான் ஏதுக்கடி - குதம்பாய்","யோகந்தான் ஏதுக்கடி ?"]},{"n":23,"label":"23","section":"கண்ணிகள்","lines":["மாத்தானை வென்று மலைமேல் இருப்போர்க்குப்","பூத்தானம் ஏதுக்கடி - குதம்பாய்","பூத்தானம் ஏதுக்கடி ?"]},{"n":24,"label":"24","section":"கண்ணிகள்","lines":["செத்தாரைப் போலத் திரியுமெய்ஞ் ஞானிக்கு","கைத்தாளம் ஏதுக்கடி - குதம்பாய்","கைத்தாளம் ஏதுக்கடி ?"]},{"n":25,"label":"25","section":"கண்ணிகள்","lines":["கண்டாரை நோக்கிக் கருத்தோடு இருப்போர்க்குக்","கொண்டாட்டம் ஏதுக்கடி - குதம்பாய்","கொண்டாட்டம் ஏதுக்கடி ?"]},{"n":26,"label":"26","section":"கண்ணிகள்","lines":["காலனை வென்ற கருத்தறி வாளர்க்குக்","கோலங்கள் ஏதுக்கடி - குதம்பாய்","கோலங்கள் ஏதுக்கடி ?"]},{"n":27,"label":"27","section":"கண்ணிகள்","lines":["வெண்காயம் உண்டு மிளகுண்டு சுக்குண்டு","உண்காயம் ஏதுக்கடி - குதம்பாய்","உண்காயம் ஏதுக்கடி ?"]},{"n":28,"label":"28","section":"கண்ணிகள்","lines":["மாங்காய்ப்பால் உண்டு மலைமேல் இருப்போர்க்குத்","தேங்காய்ப்பால் ஏதுக்கடி - குதம்பாய்","தேங்காய்ப்பால் ஏதுக்கடி ?"]},{"n":29,"label":"29","section":"கண்ணிகள்","lines":["பட்டணஞ் சுற்றிப் பகலே திரிவோர்க்கு","முட்டாக்கு ஏதுக்கடி - குதம்பாய்","முட்டாக்கு ஏதுக்கடி ?"]},{"n":30,"label":"30","section":"கண்ணிகள்","lines":["தாவரமில்லை தனக்கொரு வீடில்லை","தேவாரம் ஏதுக்கடி - குதம்பாய்","தேவாரம் ஏதுக்கடி ?"]},{"n":31,"label":"31","section":"கண்ணிகள்","lines":["தன்னை அறிந்து தலைவனைச் சேர்ந்தோர்க்குப்","பின்னாசை ஏதுக்கடி - குதம்பாய்","பின்னாசை ஏதுக்கடி ?"]},{"n":32,"label":"32","section":"கண்ணிகள்","lines":["பத்தாவுந் தானும் பதியோடு இருப்பார்க்கு","உத்தாரம் ஏதுக்கடி - குதம்பாய்","உத்தாரம் ஏதுக்கடி ?"]}]}